{
  "name": "movie-search",
  "version": "0.1.0",
  "private": true,
  "description": "Resilient movie search service (Node.js, Elasticsearch, Temporal, PostgreSQL)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "es:setup": "tsx src/elasticsearch/setupMoviesIndex.ts"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.19.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "prisma": "^7.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
